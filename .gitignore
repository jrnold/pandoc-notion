# Project-local LuaRocks tree for the optional dev tools (see `make deps`).
# Not needed to run the readers/writers or the test suite, which depend on
# nothing but pandoc.
.luarocks/

# uv-managed virtualenv and caches for notion-upload/.
notion-upload/.venv/
notion-upload/.pytest_cache/
__pycache__/

# Inherited from the monorepo's root .gitignore before this project was split
# out; kept here so the standalone repo is self-sufficient.
.superpowers/

# Hypothesis' example database, written by the uploader's property tests.
notion-upload/.hypothesis/
