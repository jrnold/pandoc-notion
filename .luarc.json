{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "Lua 5.4",
  "workspace.library": [
    ".luarocks/lib/luarocks/rocks-5.5/pandoc-annotations/0.0.1-2/library"
  ],
  "workspace.ignoreDir": [
    ".superpowers",
    ".luarocks",
    "tests/corpus",
    "tests/golden"
  ],
  "diagnostics.globals": [
    "Reader",
    "Writer"
  ],
  "diagnostics.disable": [
    "lowercase-global"
  ]
}
